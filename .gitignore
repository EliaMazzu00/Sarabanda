# Segreti locali: mai su GitHub.
# appsettings.json e appsettings.Development.json sono versionati perche'
# contengono solo configurazione pubblica (livelli di log, porta).
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.pem
*.key

# Appunti di lavoro locali (non fanno parte del progetto)
.claude/

# Le canzoni sono dell'utente: mai su GitHub (tranne il LEGGIMI della cartella).
canzoni/*
!canzoni/LEGGIMI.txt
