.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# Pacchetti e cache di ripristino
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# File di sistema
[Tt]humbs.db
ehthumbs.db
Desktop.ini
.DS_Store

